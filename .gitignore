/data/

# run outputs and everything the generators emit; nothing here is a source file
# Derived, but the aggregated summaries are small and let a reader check every
# number in the paper without re-running the grid. Per-run artifacts and the
# OOD sweep are not: see generated/README.md.
/generated/*
!/generated/README.md
!/generated/*.json
!/generated/*.csv
/generated/runs/
/generated/ood/
/generated/smoke*/
/generated/figures/
/runs/
/results/
/output/
/eval_output/
/experiments/
/logs/
/tmp/
/scratch/
*.jsonl

# working notes, only the README goes in
*.md
!README.md
!LICENSE*
!CITATION.cff
!CONTRIBUTING.md
!docs/
!docs/**/*.md

